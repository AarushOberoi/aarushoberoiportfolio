    overflow-x: auto
}

.portal-tab {
    height: 100%;
    font-family: var(--font-mono);
    color: #fff6;
    letter-spacing: .05em;
    white-space: nowrap;
    background: 0 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
