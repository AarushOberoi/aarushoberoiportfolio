    left: 0;
    box-shadow: 0 0 8px #fd5c11
}

.portal-broadcast-label {
    font-family: var(--font-mono);
    letter-spacing: .35em;
    color: #fd5c11;
    text-transform: uppercase;
    margin-bottom: .45rem;
    font-size: .6rem
}

.portal-broadcast-text {
    font-family: var(--font-mono);
    color: #ffffff80;
    letter-spacing: .08em;
    font-size: clamp(.6rem,1.5vw,.72rem);
    line-height: 1.6
}

.portal-form-group {
    flex-direction: column;
    gap: 1.5rem;
    display: flex
}

.portal-input-container {
    flex-direction: column;
    gap: .45rem;
    display: flex
}

.portal-input-label {
    font-family: var(--font-mono);
    letter-spacing: .22em;
    color: #ffffff73;
    text-transform: uppercase;
    font-size: .62rem
}

.portal-input {
    font-family: var(--font-mono);
    color: #fff;
    box-sizing: border-box;
    background: #0000004d;
    border: 1px solid #ffffff14;
    border-bottom: 2px solid #fd5c11;
    border-radius: 4px;
