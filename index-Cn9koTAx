.portal-btn:hover:not(:disabled) {
    background: #fff;
    transform: translateY(-1px);
    box-shadow: 0 0 25px #ffffff80
}

.portal-btn:disabled {
    opacity: .35;
    cursor: not-allowed;
    box-shadow: none
}

.portal-btn--ghost {
    color: #ffffffb3;
    box-shadow: none;
    background: 0 0;
    border: 1px solid #fd5c1166
