.portal-file:hover {
    color: #fff;
    background: #fd5c1114;
    border-color: #fd5c11;
    box-shadow: 0 0 15px #fd5c1126
}

.portal-btn {
    font-family: var(--font-heading);
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #000810;
    cursor: pointer;
    background: #fd5c11;
    border: none;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
