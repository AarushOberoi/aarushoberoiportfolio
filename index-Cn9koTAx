}

.portal-window-body {
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-height: 0;
    padding: clamp(1rem,3vw,2rem);
    display: flex;
    overflow-y: auto
}

.portal-dock-container {
    z-index: 100;
    pointer-events: none;
    justify-content: center;
    width: max-content;
    display: flex;
    position: fixed;
    bottom: 24px;
    left: 50%;
