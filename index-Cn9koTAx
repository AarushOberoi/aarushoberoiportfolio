}

.portal-tab--active {
    color: #fff;
    background: #ffffff1a;
    box-shadow: inset 0 2px #fd5c11
}

.portal-tab-badge {
    color: #000;
    background: #fd5c11;
    border-radius: 10px;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 2px 6px;
    font-size: .6rem;
    font-weight: 700
}

.portal-tab-logout {
    color: #ff7533;
    cursor: pointer;
    background: 0 0;
    border: none;
    flex-shrink: 0;
    padding: 4px 8px;
