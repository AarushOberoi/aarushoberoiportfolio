}

.portal-glass-card--highlight:after {
    content: "";
    background: #fd5c11;
    width: 3px;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    box-shadow: 0 0 8px #fd5c11
}

.portal-card-tag {
    font-family: var(--font-mono);
    letter-spacing: .28em;
    color: #ffffff59;
    text-transform: uppercase;
    margin-bottom: .65rem;
    font-size: .6rem
