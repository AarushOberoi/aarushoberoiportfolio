}

.portal-quick-btn-head {
    justify-content: space-between;
    align-items: center;
    margin-bottom: .35rem;
    display: flex
}

.portal-quick-btn-label {
    font-family: var(--font-heading);
    letter-spacing: .12em;
    color: #ffffffd9;
    text-transform: uppercase;
    font-size: clamp(.85rem,2vw,1.15rem)
}

.portal-quick-btn:hover .portal-quick-btn-label {
    color: #fd5c11;
    text-shadow: 0 0 10px #fd5c114d
}

.portal-quick-btn-arrow {
