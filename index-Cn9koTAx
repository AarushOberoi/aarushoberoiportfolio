.chat-input-form {
    box-sizing: border-box;
    background: #0d0d12;
    border-top: 1px solid #ffffff0d;
    flex-shrink: 0;
    gap: 10px;
    padding: clamp(.5rem,1.5vw,.85rem);
    display: flex
}

.chat-input-field {
    color: #fff;
    box-sizing: border-box;
    background: #1c1c1e;
    border: 1px solid #ffffff0f;
    border-radius: 20px;
    outline: none;
    flex: 1;
    padding: clamp(.4rem,1vw,.6rem) 1.25rem;
    font-family: -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
    font-size: clamp(.85rem,1.5vw,.92rem);
    transition: all .2s
}

.chat-input-field:focus {
    background: #242428;
    border-color: #fd5c1166
