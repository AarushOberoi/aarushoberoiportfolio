.site-main {
    color: #ece8e4;
    background: 0 0;
    min-height: 100dvh
}

.oc3-body {
    color: #f0ece8e6;
    text-align: left;
    font-family: Rajdhani,sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.65
}

.oc3-eyebrow {
    letter-spacing: .28em;
    text-transform: uppercase;
    color: #c42d52;
    margin-bottom: .75rem;
    font-family: Share Tech Mono,monospace;
    font-size: .7rem
}

.oc3-h1 {
    letter-spacing: .04em;
    color: #f5f2ef;
    text-align: left;
    font-family: Bebas Neue,sans-serif;
    font-size: clamp(2.75rem,7vw,5.5rem);
    line-height: .95
}

.oc3-h2 {
    color: #f5f2ef;
    text-align: left;
    font-family: Bebas Neue,sans-serif;
    font-size: clamp(2rem,4.5vw,3.25rem);
    line-height: 1
}

.oc3-h2 em {
    color: #fd5c11;
    font-style: normal
}

.oc3-lead {
    color: #f0ece8e0;
    text-align: left;
    max-width: 42rem;
    font-family: Rajdhani,sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.65
}

.oc3-muted {
    letter-spacing: .12em;
    color: #ece8e473;
    font-family: Share Tech Mono,monospace;
    font-size: .72rem
}

.opcode-display--hero,.opcode-hero-title {
    text-align: left;
    letter-spacing: .02em;
    opacity: 1;
    visibility: visible;
    text-shadow: 0 0 60px #fd5c1140;
    font-size: clamp(4.5rem,14vw,11rem);
    line-height: .88;
    display: block;
    font-family: var(--font-opcode),sans-serif!important;
    color: #f5f2ef!important
}

.opcode-display--section {
    color: #fd5c11;
    text-align: left;
    font-size: clamp(2.5rem,6vw,4.5rem);
    line-height: 1;
    display: block
}

.opcode-display--inline {
    color: #fd5c11;
    font-size: 1.5rem
}

.gsap-char.font-opcode,.font-opcode .gsap-char {
    font-weight: 400;
    font-family: var(--font-opcode),sans-serif!important
}

.oc3-back {
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #ece8e48c;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.5rem;
    padding: 10px 0;
    font-family: Share Tech Mono,monospace;
    font-size: .72rem;
    text-decoration: none;
    transition: color .2s;
    display: inline-flex
}

.oc3-back:hover {
    color: #fd5c11
}

.oc3-back__arrow {
    color: #fd5c11;
    font-size: 1.1rem
}

.oc3-page {
    text-align: left;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem clamp(1.25rem,4vw,3rem) 4rem
}

.oc3-page__top {
    margin-bottom: .5rem
}

.oc-dock-wrap {
    z-index: 60000;
    pointer-events: none;
    width: min(1120px,100% - 32px);
    transition: top .35s,width .35s;
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translate(-50%)
}

.oc-dock-wrap--scrolled {
    width: min(1120px,100% - 20px);
    top: 10px
}

.oc-dock {
    pointer-events: auto;
    -webkit-backdrop-filter: blur(22px)saturate(1.35);
    backdrop-filter: blur(22px)saturate(1.35);
    clip-path: polygon(14px 0%,100% 0%,calc(100% - 14px) 100%,0% 100%);
    background: #080808c7;
    border: 1px solid #fd5c1161;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 10px 14px 10px 20px;
    display: flex;
    box-shadow: 0 20px 60px #0000008c,inset 0 1px #ffffff0d,0 0 0 1px #fd5c1114
}

.oc-dock-wrap--scrolled .oc-dock {
    background: #060606f0;
    border-color: #fd5c1180
}

.oc-dock__brand {
    flex-shrink: 0;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    display: flex
}

.oc-dock__logo-ring {
    clip-path: polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);
    background: #fd5c1114;
    border: 1px solid #fd5c1173;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    display: flex
}

.oc-dock__logo-ring img {
    width: auto;
    height: 26px
}

.oc-dock__wordmark {
    line-height: 1;
    color: #fd5c11!important;
    font-size: 1.45rem!important
}

.oc-dock__links {
    flex: 1;
    justify-content: center;
    align-items: center;
    gap: 26px;
    margin: 0;
    padding: 0 8px;
    list-style: none;
    display: flex
}

.oc-dock__link {
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #f0ece873;
    cursor: pointer;
    background: 0 0;
    border: none;
    align-items: center;
    gap: 8px;
    padding: 0;
    font-family: Share Tech Mono,monospace;
    font-size: .68rem;
    text-decoration: none;
    transition: color .2s;
    display: inline-flex;
    position: relative
}

.oc-dock__link-dot {
    opacity: 0;
    background: #fd5c11;
    width: 4px;
    height: 4px;
    transition: opacity .2s,transform .2s;
    transform: scale(0)
}

.oc-dock__link--active,.oc-dock__link:hover {
    color: #fd5c11
}

.oc-dock__link--active .oc-dock__link-dot,.oc-dock__link:hover .oc-dock__link-dot {
    opacity: 1;
    transform: scale(1)
}

.oc-dock__actions {
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    display: flex
}

.oc-dock__cta {
    letter-spacing: .2em;
    color: #f0ece8;
    clip-path: polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
    white-space: nowrap;
    background: #fd5c11;
    padding: 11px 22px;
    font-family: Bebas Neue,sans-serif;
    font-size: .95rem;
    text-decoration: none;
    transition: box-shadow .25s,transform .25s;
    box-shadow: 0 0 28px #fd5c1173
}

.oc-dock__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 40px #fd5c11a6
}

.oc-dock__link--portal {
    color: #f0ece88c
}

.oc-dock__logout {
    color: #f0ece859
}

.oc-hamburger {
    cursor: pointer;
    clip-path: polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);
    background: #fd5c110f;
    border: 1px solid #fd5c1173;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: none;
    position: relative
}

.oc-hamburger:before,.oc-hamburger:after {
    content: "";
    background: #fd5c11;
    height: 2px;
    transition: transform .3s;
    position: absolute;
    left: 11px;
    right: 11px
}

.oc-hamburger:before {
    top: 15px;
    box-shadow: 0 8px #fd5c11
}

.oc-hamburger:after {
    bottom: 15px
}

.oc-hamburger--open:before {
    box-shadow: none;
    transform: translateY(8px)rotate(45deg)
}

.oc-hamburger--open:after {
    transform: translateY(-8px)rotate(-45deg)
}

.oc-dock-wrap--menu-open {
    z-index: 70002
}

.oc-dock-wrap--menu-open .oc-dock__brand,.oc-dock-wrap--menu-open .oc-nav-list,.oc-dock-wrap--menu-open .oc-nav-actions {
    opacity: 0;
    pointer-events: none
}

.oc-dock-wrap--menu-open .oc-hamburger {
    opacity: 1;
    pointer-events: auto
}

.oc-mobile-menu__backdrop {
    z-index: 70000;
    background: #000000bf;
    position: fixed;
    inset: 0
}

.oc-mobile-menu {
    z-index: 70001;
    pointer-events: none;
    visibility: hidden;
    background: #050505;
    border-right: 1px solid #fd5c1159;
    flex-direction: column;
    width: min(420px,92vw);
    padding: 1.25rem 1.75rem 2rem;
    transition: transform .4s cubic-bezier(.16,1,.3,1);
    display: flex;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    transform: translate(-100%);
    box-shadow: 24px 0 80px #0009
}

.oc-mobile-menu--open {
    pointer-events: auto;
    visibility: visible;
    transform: translate(0)
}

.oc-mobile-menu__head {
    border-bottom: 1px solid #fd5c1140;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    display: flex
}

.oc-mobile-menu__logo img {
    width: auto;
    height: 40px
}

.oc-mobile-menu__close {
    color: #fd5c11;
    cursor: pointer;
    clip-path: polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);
    background: 0 0;
    border: 1px solid #fd5c1166;
    padding: 10px 14px;
    font-family: Share Tech Mono,monospace;
    font-size: 1.1rem
}

.oc-mobile-menu__nav {
    flex-direction: column;
    flex: 1;
    gap: .15rem;
    display: flex
}

.oc-mobile-menu__link {
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #f0ece86b;
    padding: .2rem 0;
    font-family: Bebas Neue,sans-serif;
    font-size: clamp(2.25rem,10vw,3.25rem);
    line-height: 1.1;
    text-decoration: none;
    animation: .45s backwards oc3-nav-in
}

.oc-mobile-menu__link--on,.oc-mobile-menu__link:hover {
    color: #fd5c11
}

.oc-mobile-menu__actions {
    flex-direction: column;
    gap: .75rem;
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex
}

.oc-mobile-menu__cta {
    letter-spacing: .2em;
    text-align: center;
    color: #f0ece8;
    clip-path: polygon(14px 0%,100% 0%,calc(100% - 14px) 100%,0% 100%);
    background: #fd5c11;
    padding: 1rem 1.5rem;
    font-family: Bebas Neue,sans-serif;
    font-size: 1.65rem;
    text-decoration: none;
    transition: transform .25s,box-shadow .25s;
    box-shadow: 0 0 32px #fd5c1166
}

.oc-mobile-menu__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 48px #fd5c118c
}

.oc-mobile-menu__cta--ghost {
    color: #f0ece8b3;
    box-shadow: none;
    background: 0 0;
    border: 1px solid #fd5c1173
}

@keyframes oc3-nav-in {
    0% {
        opacity: 0;
        transform: translate(-20px)
    }

    to {
        opacity: 1;
        transform: translate(0)
    }
}

.oc3-home {
    overflow-x: hidden
}

.oc3-hero {
    text-align: left;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 1200px;
    min-height: calc(100dvh - 80px);
    margin: 0 auto;
    padding: 6.5rem clamp(1.25rem,4vw,3rem) 3rem;
    display: flex;
    position: relative;
    overflow: hidden
}

.oc3-hero__bg {
    pointer-events: none;
    background: radial-gradient(70% 55% at 15% 35%,#fd5c1133,#0000 65%),linear-gradient(#0a0a0a,#060606);
    position: absolute;
    inset: 0
}

.oc3-hero__lines {
    pointer-events: none;
    background-color: #0000;
    background-image: linear-gradient(#fd5c1114 1px,#0000 1px),linear-gradient(90deg,#fd5c1114 1px,#0000 1px);
    background-position: 0 0,0 0;
    background-repeat: repeat,repeat;
    background-size: 48px 48px;
    background-attachment: scroll,scroll;
    background-origin: padding-box,padding-box;
    background-clip: border-box,border-box;
    height: 40%;
    position: absolute;
    inset: auto 0 0;
    -webkit-mask-image: linear-gradient(#0000,#000);
    mask-image: linear-gradient(#0000,#000)
}

.oc3-hero__inner {
    z-index: 2;
    max-width: 720px;
    position: relative
}

.oc3-hero__outline {
    letter-spacing: .42em;
    color: #0000;
    -webkit-text-stroke: 1px #fd5c11bf;
    text-align: left;
    margin-top: .35rem;
    font-family: Bebas Neue,sans-serif;
    font-size: clamp(1.5rem,3vw,2.25rem);
    display: block
}

.oc3-hero__actions {
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2rem;
    display: flex
}

.oc3-btn {
    letter-spacing: .18em;
    text-transform: uppercase;
    padding: 1rem 1.75rem;
    font-family: Share Tech Mono,monospace;
    font-size: .72rem;
    text-decoration: none;
    transition: box-shadow .25s,transform .25s;
    display: inline-block
}

.oc3-btn--primary {
    color: #fff;
    background: #fd5c11;
    border: none
}

.oc3-btn--primary:hover {
    box-shadow: 0 0 32px #fd5c1180
}

.oc3-btn--ghost {
    color: #ece8e4;
    background: 0 0;
    border: 1px solid #fd5c1173
}

.oc3-stats {
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2.5rem;
    display: flex
}

.oc3-stat {
    background: #0c0c0cd9;
    border: 1px solid #fd5c1140;
    min-width: 120px;
    padding: 1rem 1.25rem
}

.oc3-stat strong {
    color: #fd5c11;
    font-family: Bebas Neue,sans-serif;
    font-size: 2.25rem;
    line-height: 1;
    display: block
}

.oc3-stat span {
    letter-spacing: .15em;
    color: #ece8e466;
    text-transform: uppercase;
    font-family: Share Tech Mono,monospace;
    font-size: .65rem
}

.oc3-section {
    text-align: left;
    border-top: 1px solid #fd5c111f;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4.5rem clamp(1.25rem,4vw,3rem)
}

.oc3-section--dark {
    background: #0a0a0a;
    max-width: none;
    padding-inline:clamp(1.25rem,4vw,3rem)}

.oc3-section--dark .oc3-section__inner {
    max-width: 1200px;
    margin: 0 auto
}

.oc3-marquee {
    background: #0a0a0a;
    border-block:1px solid #fd5c114d;padding: 1rem 0;
    overflow: hidden
}

.oc3-marquee__track {
    white-space: nowrap;
    width: max-content;
    animation: 24s linear infinite oc3-marquee;
    display: flex
}

.oc3-marquee__item {
    letter-spacing: .35em;
    color: #ece8e4bf;
    padding: 0 2.5rem;
    font-family: Bebas Neue,sans-serif;
    font-size: 1.1rem
}

.oc3-marquee__item--brand {
    font-family: var(--font-opcode);
    color: #fd5c11
}

@keyframes oc3-marquee {
    0% {
        transform: translate(0)
    }

    to {
        transform: translate(-50%)
    }
}

.oc3-grid-2 {
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 2.5rem;
    display: grid
}

.oc3-terminal {
    color: #ece8e4a6;
    background: #0c0c0c;
    border: 1px solid #fd5c114d;
    padding: 1.5rem;
    font-family: Share Tech Mono,monospace;
    font-size: .8rem;
    line-height: 1.85
}

.oc3-cards {
    grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
    gap: 1rem;
    display: grid
}

.oc-hover-card {
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform .45s cubic-bezier(.23,1,.32,1),box-shadow .45s cubic-bezier(.23,1,.32,1),border-color .3s
}

.oc-hover-card:hover {
    transform: translateY(-14px)translate(6px)rotate(-1.5deg);
    box-shadow: 0 28px 56px #0000008c,0 0 40px #fd5c1138;
    border-color: #fd5c118c!important
}

.oc3-card {
    color: inherit;
    text-align: left;
    background: #0c0c0c;
    border: 1px solid #fd5c1133;
    padding: 1.75rem 1.5rem;
    text-decoration: none;
    display: block
}

.oc3-card:hover {
    border-color: #fd5c118c
}

.oc3-card__num {
    color: #fd5c1126;
    font-family: Bebas Neue,sans-serif;
    font-size: 3rem;
    line-height: 1
}

.oc3-card__title {
    color: #f5f2ef;
    margin: .5rem 0 .35rem;
    font-family: Bebas Neue,sans-serif;
    font-size: 1.75rem
}

.oc3-card__desc {
    color: #ece8e48c;
    font-size: .95rem;
    line-height: 1.5
}

.oc3-card--accent {
    background: linear-gradient(145deg,#fd5c1159,#0c0c0c 55%);
    border-color: #fd5c1173
}

.oc3-cta-band {
    text-align: left;
    background: linear-gradient(135deg,#cc4a0e,#fd5c11 45%,#99370a);
    padding: 5rem clamp(1.25rem,4vw,3rem)
}

.oc3-cta-band .oc3-h2 {
    color: #fff
}

.oc3-cta-band .oc3-lead {
    color: #ffffffe6
}

.oc3-tier {
    margin-bottom: 3rem
}

.oc3-tier__label {
    border-bottom: 2px solid #fd5c1140;
    align-items: baseline;
    gap: .75rem;
    margin-bottom: 1.5rem;
    padding-bottom: .75rem;
    display: flex
}

.oc3-tier__main {
    color: #f5f2ef;
    font-family: Rajdhani,sans-serif;
    font-size: 1.75rem;
    font-weight: 600
}

.oc3-tier__sub {
    color: #fd5c11;
    font-family: Bebas Neue,sans-serif;
    font-size: 2.5rem
}

.oc3-member-grid {
    grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
    gap: 1rem;
    display: grid
}

.oc3-member {
    text-align: center;
    cursor: pointer;
    background: #0c0c0c;
    border: 1px solid #fd5c112e;
    padding: 1.5rem 1rem;
    transition: border-color .25s
}

.oc3-member:hover {
    border-color: #fd5c1180
}

.oc3-member__av {
    color: #fff;
    background: #fd5c11;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 1rem;
    font-family: Bebas Neue,sans-serif;
    font-size: 1.35rem;
    display: flex
}

.oc3-member__name {
    color: #f5f2ef;
    font-family: Bebas Neue,sans-serif;
    font-size: 1.35rem
}

.oc3-member__role {
    letter-spacing: .12em;
    color: #c42d52;
    text-transform: uppercase;
    margin-top: .35rem;
    font-family: Share Tech Mono,monospace;
    font-size: .65rem
}

.oc3-timeline {
    border-left: 2px solid #fd5c1159;
    flex-direction: column;
    gap: 0;
    margin: 2rem 0 0 .5rem;
    padding: 0;
    list-style: none;
    display: flex
}

.oc3-timeline__item {
    border-bottom: 1px solid #fd5c111f;
    padding: 1.25rem 0 1.25rem 2rem;
    position: relative
}

.oc3-timeline__item:before {
    content: "";
    background: #fd5c11;
    border: 2px solid #060606;
    width: 12px;
    height: 12px;
    position: absolute;
    top: 1.6rem;
    left: -7px;
    transform: rotate(45deg)
