.chat-transmit-btn {
    color: #fff;
    cursor: pointer;
    background: #fd5c11;
    border: none;
    border-radius: 50%;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    font-size: 1.1rem;
    transition: all .2s;
    display: flex;
    box-shadow: 0 2px 6px #fd5c114d
}

.chat-transmit-btn:hover {
    background: #ff3b4a;
    transform: scale(1.05);
    box-shadow: 0 0 15px #ff3b4a80
}

.portal-user-list {
    background: #ffffff0d;
    flex-direction: column;
    gap: 1px;
    max-height: 320px;
    display: flex;
    overflow-y: auto
}

.portal-user-row {
    background: #090b10;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: clamp(.5rem,1vw,.75rem) 1rem;
    transition: all .2s;
    display: flex
}

.portal-user-row:hover {
    background: #fd5c1108
}

.portal-user-id {
    font-family: var(--font-mono);
    color: #fd5c11;
    width: 85px;
    font-size: .72rem
}

.portal-user-name-text {
    font-family: var(--font-sans);
    color: #fff;
    flex: 1;
    min-width: 0;
    font-size: clamp(.8rem,1.5vw,.9rem)
}

.portal-user-sort {
    font-family: var(--font-mono);
    color: #ffffff80;
    font-size: .65rem
}

.portal-user-badge-tag {
    font-family: var(--font-mono);
    letter-spacing: .1em;
    color: #fd5c11;
    text-transform: uppercase;
    background: #fd5c1126;
    border-radius: 3px;
    flex-shrink: 0;
    padding: 2px 6px;
    font-size: .6rem
}

.portal-photo-preview {
    border: 1px solid #ffffff14;
    border-radius: 2px;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    overflow: hidden
}

.portal-photo-preview img {
    object-fit: cover;
    width: 100%;
    height: 100%
}

.portal-task-card {
    background: #00000040;
    border: 1px solid #ffffff0d;
    border-radius: 4px;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(.75rem,1.5vw,1.05rem);
    transition: all .25s;
    display: flex
}

.portal-task-card:hover {
    background: #fd5c1103;
    border-color: #fd5c114d
}

.portal-task-title {
    font-family: var(--font-sans);
    color: #fff;
    margin-bottom: .15rem;
    font-size: clamp(.9rem,1.5vw,1.05rem);
    font-weight: 600
}

.portal-task-desc {
    font-family: var(--font-mono);
    color: #ffffff73;
    font-size: clamp(.65rem,1.2vw,.72rem)
}

@media(max-width: 768px) {
    .portal-window-header {
        flex-wrap:wrap
    }

    .portal-window-tabs {
        border-top: 1px solid #ffffff0d;
        order: 3;
        width: 100%;
        margin-top: 4px;
        padding-top: 4px
    }

    .portal-welcome h1 {
        font-size: clamp(1.2rem,4vw,2.5rem)
    }

    .nav-overlay__item-label {
        font-size: clamp(1.5rem,6vw,2.5rem)
    }
}

@media(max-width: 480px) {
    .portal-grid-layout,.portal-quick-grid {
        grid-template-columns:1fr
    }

    .chat-msg-bubble {
        max-width: 95%
    }

    .portal-glass-card {
        padding: .75rem 1rem
    }
}

@layer theme {
    :root,:host {
        --font-sans: "Rajdhani", sans-serif;
        --font-mono: "Share Tech Mono", monospace;
        --color-orange-50: oklch(98% .016 73.684);
        --color-orange-300: oklch(83.7% .128 66.29);
        --color-orange-400: oklch(75% .183 55.934);
        --color-orange-600: oklch(64.6% .222 41.116);
        --color-black: #000;
        --spacing: .25rem;
        --container-lg: 32rem;
        --text-xs: .75rem;
        --text-xs--line-height: calc(1 / .75);
        --text-sm: .875rem;
        --text-sm--line-height: calc(1.25 / .875);
        --text-lg: 1.125rem;
        --text-lg--line-height: calc(1.75 / 1.125);
        --font-weight-medium: 500;
        --font-weight-semibold: 600;
        --tracking-tight: -.025em;
        --default-transition-duration: .15s;
        --default-transition-timing-function: cubic-bezier(.4, 0, .2, 1);
        --default-font-family: "Rajdhani", sans-serif;
        --default-mono-font-family: "Share Tech Mono", monospace;
        --font-opcode: "OPCODE", sans-serif
    }
}

@layer base {
    *,:after,:before,::backdrop {
        box-sizing: border-box;
        border: 0 solid;
        margin: 0;
        padding: 0
    }

    ::file-selector-button {
        box-sizing: border-box;
        border: 0 solid;
        margin: 0;
        padding: 0
    }

    html,: host {
        -webkit-text-size-adjust:100%;
        tab-size: 4;
        line-height: 1.5;
        font-family: var(--default-font-family,ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji");
        font-feature-settings: var(--default-font-feature-settings,normal);
        font-variation-settings: var(--default-font-variation-settings,normal);
        -webkit-tap-highlight-color: transparent
    }

    hr {
        height: 0;
        color: inherit;
        border-top-width: 1px
