.portal-window-dots {
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    display: flex
}

.portal-window-dot {
    background: #ffffff26;
    border-radius: 50%;
    flex-shrink: 0;
    width: 8px;
    height: 8px
}

.portal-window-dot--orange,.portal-window-dot--yellow {
