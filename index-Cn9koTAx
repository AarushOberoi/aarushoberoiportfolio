}

.portal-input::placeholder {
    color: #ffffff2e
}

.portal-select {
    font-family: var(--font-mono);
    color: #fff;
    cursor: pointer;
    box-sizing: border-box;
    background: #0000004d;
    border: 1px solid #ffffff14;
    border-bottom: 2px solid #fd5c11;
    border-radius: 4px;
    outline: none;
    width: 100%;
    padding: clamp(.5rem,1vw,.75rem);
    font-size: clamp(.75rem,1.5vw,.82rem);
    transition: all .3s
}

.portal-select:focus {
    border-color: #fd5c1180
}

.portal-file {
    width: 100%;
    font-family: var(--font-mono);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #fd5c11;
    cursor: pointer;
    box-sizing: border-box;
    background: #fd5c1105;
    border: 1px dashed #fd5c1166;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    padding: clamp(.5rem,1vw,.8rem);
    font-size: .75rem;
    transition: all .3s;
    display: inline-flex
